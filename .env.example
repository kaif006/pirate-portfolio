# Copy to .env.local and fill in. NEVER commit .env.local.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Google AI Studio API key
GEMINI_API_KEY=
# Model names (check Google AI Studio for currently available models)
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Supabase (Project Settings -> API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=kaifjallalani@gmail.com
# Use a sender on a domain verified in Resend for production.
# With no sender set, onboarding@resend.dev only supports the Resend account's own email.
# CONTACT_FROM_EMAIL="Portfolio <contact@example.com>"

# Any long random string (used to hash visitor IPs for rate limiting)
IP_HASH_SALT=
